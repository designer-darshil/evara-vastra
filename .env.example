# ==========================================================
# EVARA VASTRA — SERVER ENVIRONMENT VARIABLES
# ==========================================================

# Shiprocket fastrr Checkout & Payment Engine
# (SERVER-SIDE ONLY — NEVER EXPOSE TO CLIENT/REACT BUNDLE)
FASTRR_APP_ID=your_fastrr_app_id
FASTRR_AUTH_TOKEN=your_fastrr_secret_auth_token
FASTRR_WEBHOOK_SECRET=your_fastrr_webhook_secret
PAYMENT_ENV=test # Change to 'production' for live payment gateway

# Shiprocket Production Logistics Credentials
SHIPROCKET_EMAIL=operations@evaravastra.com
SHIPROCKET_PASSWORD=your_secure_shiprocket_api_password
SHIPROCKET_BASE_URL=https://apiv2.shiprocket.in/v1/external
SHIPROCKET_WEBHOOK_TOKEN=your_secure_webhook_secret_token

# Evara Vastra Production Warehouse
DEFAULT_PICKUP_LOCATION_NAME=Surat Atelier Primary
DEFAULT_PICKUP_PINCODE=395002
